class=\"mord mathnormal\">μ</span></span></span></span>","key":"wyj0b1JVrp"},{"type":"text","value":" the same. The symmetry condition required is satisfied.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rGj0btY2Eh"}],"key":"TkSlaTlOH3"}],"identifier":"df57e459","html_id":"df57e459","key":"s6JJ0qSLTZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def trans(theta):\n    return [theta[0], abs(np.random.normal(theta[1], 0.5))]","key":"ccQe829HIt"},{"type":"outputs","id":"0lAVagiOrp4Q5WaGGe0o1","children":[],"key":"QBpltqgjxG"}],"identifier":"22d3f482","html_id":"22d3f482","key":"fJ0B6kdi15"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def like (theta, data):\n    return np.sum(-np.log(theta[1]*np.sqrt(2*np.pi)) - ((data - theta[0])**2)/(2*theta[1]**2))\n\ndef accept(x, y):\n    return np.random.uniform(0, 1) < np.exp(y - x)\n\ndef metropolis_hastings(theta, data):\n    theta_new = trans(theta)\n    H_old = like(theta, data)\n    H_new = like(theta_new, data)\n    return {'theta': theta_new, 'old': H_old, 'new': H_new}","key":"EdSXylHtqj"},{"type":"outputs","id":"0xKMlxcwfiYbbJMia6MMq","children":[],"key":"VLErOxzW3O"}],"identifier":"2ea12ac6","html_id":"2ea12ac6","key":"lQXCntLMNN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We now build the markov chain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IwYXwr2wZH"}],"key":"mANzLfI6VL"}],"identifier":"7a5772ab","html_id":"7a5772ab","key":"cnR1MiUSq3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def MCMC(proc, theta_init, iters, data):\n    theta = theta_init\n    output = []\n    accept_reject = []\n    for i in range(1, iters + 1):\n        res = proc(theta, data)\n        if accept(res['old'], res['new']):\n            theta = res['theta']\n            accept_reject.append(1)\n        else:\n            accept_reject.append(0)\n        output.append(theta)\n    return {'output': np.array(output), 'accept_reject': np.array(accept_reject)}\n\n","key":"nbDOvkIzpj"},{"type":"outputs","id":"QtcK0W_TcwM47X9ZPIZLN","children":[],"key":"SwhtSfsB9x"}],"identifier":"3857e584","html_id":"3857e584","key":"JkwYdOwgkl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let us now look at the results.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dMWHpc8KUS"}],"key":"DjXTHsIg13"}],"identifier":"c57dc052","html_id":"c57dc052","key":"v0bsOUGFqY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import japanize_matplotlib\nm = 50000\nresult = MCMC(metropolis_hastings, [mu_obs, 3], m, obs)\noutput = result['output']\noutput2 = output[:, 1]\ncolors = 2 * result['accept_reject'] + 2\niterations = range(1, m+1) \nplt.plot(iterations[:len(output2)], output2, color = 'blue', marker='o')\nplt.xlabel('Number of iterations')\nplt.ylabel('Value of sigma') \nplt.ylim(1.0, 5.0) \nplt.title('Generated parameters') \nplt.legend(['accepted', 'rejected']) \nplt.show()","key":"fxqglk5Knt"},{"type":"outputs","id":"EgiyQkvHNAsR8gaPyKL2X","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5fa934f58e3d0b2b6968431ee66f752b","path":"/Singular_Learning_Theory/build/5fa934f58e3d0b2b6968431ee66f752b.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"bEk3QEeKyc"}],"key":"ZCojfPmbK6"}],"identifier":"01f09b24","html_id":"01f09b24","key":"wQjQLNWrY6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.hist(output2 , bins=np.append(np.arange(0, 5, 0.01), 5), edgecolor='black', alpha=0.7, density = True)\nplt.xlim(1, 5)\nplt.xlabel('Value of sigma') \nplt.ylabel('Probability density') \nplt.title('Posterior distribution of sigma') \nplt.show()","key":"f1GzeAfj0W"},{"type":"outputs","id":"ow0_MOQ_dy2cK_HMZh-E4","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"004f659fc6364ecaca5982c77fa0c0b9","path":"/Singular_Learning_Theory/build/004f659fc6364ecaca5982c77fa0c0b9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"w4ZThwcPI1"}],"key":"nVwD40JwWt"}],"identifier":"0dbf4351","html_id":"0dbf4351","key":"txqyKkVb4G"}],"key":"zu9AI4pzHC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Example 6","url":"/example-6","group":"Introduction to Bayesian Statistics"},"next":{"title":"Problems","url":"/exercises1","group":"Introduction to Bayesian Statistics"}}},"domain":"http://localhost:3000"}