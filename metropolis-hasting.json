class=\"mord mathnormal\">μ</span></span></span></span>","key":"Vo8zfD1WaW"},{"type":"text","value":" the same. The symmetry condition required is satisfied.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n8LFnsuTv0"}],"key":"oU4nAMlOjz"}],"identifier":"df57e459","html_id":"df57e459","key":"EbgP0ISqb9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def trans(theta):\n    return [theta[0], abs(np.random.normal(theta[1], 0.5))]","key":"serAoOUbLT"},{"type":"outputs","id":"1nCgsb3bQnqJ9fM-N4naD","children":[],"key":"iK3z34y9bM"}],"identifier":"22d3f482","html_id":"22d3f482","key":"v43tAladcN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def like (theta, data):\n    return np.sum(-np.log(theta[1]*np.sqrt(2*np.pi)) - ((data - theta[0])**2)/(2*theta[1]**2))\n\ndef accept(x, y):\n    return np.random.uniform(0, 1) < np.exp(y - x)\n\ndef metropolis_hastings(theta, data):\n    theta_new = trans(theta)\n    H_old = like(theta, data)\n    H_new = like(theta_new, data)\n    return {'theta': theta_new, 'old': H_old, 'new': H_new}","key":"KevjkksHyh"},{"type":"outputs","id":"cXu0W1fJ0seDJWAGQXJeN","children":[],"key":"Q03Un1eetR"}],"identifier":"2ea12ac6","html_id":"2ea12ac6","key":"YVEaQWgXJt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We now build the markov chain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RhdhBrHp2O"}],"key":"N9NPkNROQa"}],"identifier":"7a5772ab","html_id":"7a5772ab","key":"lxaX3kM5et"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def MCMC(proc, theta_init, iters, data):\n    theta = theta_init\n    output = []\n    accept_reject = []\n    for i in range(1, iters + 1):\n        res = proc(theta, data)\n        if accept(res['old'], res['new']):\n            theta = res['theta']\n            accept_reject.append(1)\n        else:\n            accept_reject.append(0)\n        output.append(theta)\n    return {'output': np.array(output), 'accept_reject': np.array(accept_reject)}\n\n","key":"qJIpsk2id8"},{"type":"outputs","id":"6q6lImSf_3jG9sj_MupAc","children":[],"key":"Q3MBp1iCmm"}],"identifier":"3857e584","html_id":"3857e584","key":"vkRMGhRo2c"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let us now look at the results.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UxMOEIOeay"}],"key":"nR78my0C4Y"}],"identifier":"c57dc052","html_id":"c57dc052","key":"u781PyBy8u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import japanize_matplotlib\nm = 50000\nresult = MCMC(metropolis_hastings, [mu_obs, 3], m, obs)\noutput = result['output']\noutput2 = output[:, 1]\ncolors = 2 * result['accept_reject'] + 2\niterations = range(1, m+1) \nplt.plot(iterations[:len(output2)], output2, color = 'blue', marker='o')\nplt.xlabel('Number of iterations')\nplt.ylabel('Value of sigma') \nplt.ylim(1.0, 5.0) \nplt.title('Generated parameters') \nplt.legend(['accepted', 'rejected']) \nplt.show()","key":"HvowqKplmt"},{"type":"outputs","id":"gHUgv-3bgxtXkpYqX6ZdF","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5fa934f58e3d0b2b6968431ee66f752b","path":"/Singular_Learning_Theory/build/5fa934f58e3d0b2b6968431ee66f752b.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Hm5lS7Xmt8"}],"key":"cU2bvrxivm"}],"identifier":"01f09b24","html_id":"01f09b24","key":"tdWLMeC0XX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.hist(output2 , bins=np.append(np.arange(0, 5, 0.01), 5), edgecolor='black', alpha=0.7, density = True)\nplt.xlim(1, 5)\nplt.xlabel('Value of sigma') \nplt.ylabel('Probability density') \nplt.title('Posterior distribution of sigma') \nplt.show()","key":"PNV17f5vqb"},{"type":"outputs","id":"oh3XYaR1j1_7lT0qLl9Er","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"004f659fc6364ecaca5982c77fa0c0b9","path":"/Singular_Learning_Theory/build/004f659fc6364ecaca5982c77fa0c0b9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Vj94kdpD25"}],"key":"dbak8P4XLG"}],"identifier":"0dbf4351","html_id":"0dbf4351","key":"ZZUooNqkig"}],"key":"Koa6mEerlt"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Example 6","url":"/example-6","group":"Introduction to Bayesian Statistics"},"next":{"title":"Problems","url":"/exercises1","group":"Introduction to Bayesian Statistics"}}},"domain":"http://localhost:3000"}