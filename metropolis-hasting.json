h","value":"\\theta = (\\mu, \\sigma)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>θ</mi><mo>=</mo><mo stretchy=\"false\">(</mo><mi>μ</mi><mo separator=\"true\">,</mo><mi>σ</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">\\theta = (\\mu, \\sigma)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">μ</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mclose\">)</span></span></span></span>","key":"WS4PKex4Jy"},{"type":"text","value":". We keep ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ue5nKb2nGs"},{"type":"inlineMath","value":"\\mu","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>μ</mi></mrow><annotation encoding=\"application/x-tex\">\\mu</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span></span></span></span>","key":"R1ovv6t98H"},{"type":"text","value":" the same. The symmetry condition required is satisfied.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qaSBJuRiV0"}],"key":"T0OAPtcdwx"}],"key":"sKwi6BvUAj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def trans(theta):\n    return [theta[0], abs(np.random.normal(theta[1], 0.5))]","key":"sxnQWLYbrE"},{"type":"outputs","id":"LWDMSfNYgxLFuWaoZceD1","children":[],"key":"miIfGZhbCi"}],"key":"NIILn1Ypzi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def like (theta, data):\n    return np.sum(-np.log(theta[1]*np.sqrt(2*np.pi)) - ((data - theta[0])**2)/(2*theta[1]**2))\n\ndef accept(x, y):\n    return np.random.uniform(0, 1) < np.exp(y - x)\n\ndef metropolis_hastings(theta, data):\n    theta_new = trans(theta)\n    H_old = like(theta, data)\n    H_new = like(theta_new, data)\n    return {'theta': theta_new, 'old': H_old, 'new': H_new}","key":"UxlNyeac3E"},{"type":"outputs","id":"eNxDhOo6pJlitQ72ROuC-","children":[],"key":"wpAIZmomVX"}],"key":"tjlKrxOY1B"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We now build the markov chain.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ma1G8ozP3a"}],"key":"JWVEuOPt96"}],"key":"azTaJOKiGF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def MCMC(proc, theta_init, iters, data):\n    theta = theta_init\n    output = []\n    accept_reject = []\n    for i in range(1, iters + 1):\n        res = proc(theta, data)\n        if accept(res['old'], res['new']):\n            theta = res['theta']\n            accept_reject.append(1)\n        else:\n            accept_reject.append(0)\n        output.append(theta)\n    return {'output': np.array(output), 'accept_reject': np.array(accept_reject)}\n\n","key":"tWcyAuj9OO"},{"type":"outputs","id":"xok-k3WyJLDsLPPKc8PlX","children":[],"key":"LLN1zQNK4j"}],"key":"spqTp5n7wB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let us now look at the results.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vXJAMYywh3"}],"key":"vevLScnLIi"}],"key":"uY3TmKgFw9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import japanize_matplotlib\nm = 50000\nresult = MCMC(metropolis_hastings, [mu_obs, 3], m, obs)\noutput = result['output']\noutput2 = output[:, 1]\ncolors = 2 * result['accept_reject'] + 2\niterations = range(1, m+1) \nplt.plot(iterations[:len(output2)], output2, color = 'blue', marker='o')\nplt.xlabel('Number of iterations')\nplt.ylabel('Value of sigma') \nplt.ylim(1.0, 5.0) \nplt.title('Generated parameters') \nplt.legend(['accepted', 'rejected']) \nplt.show()","key":"yPv9X90IHz"},{"type":"outputs","id":"Na_5Xd-ZyBsy4cSEBampe","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5fa934f58e3d0b2b6968431ee66f752b","path":"/Singular_Learning_Theory/build/5fa934f58e3d0b2b6968431ee66f752b.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"ptrmczQbfO"}],"key":"PfaUQOs6lw"}],"key":"fa55BGWgQP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.hist(output2 , bins=np.append(np.arange(0, 5, 0.01), 5), edgecolor='black', alpha=0.7, density = True)\nplt.xlim(1, 5)\nplt.xlabel('Value of sigma') \nplt.ylabel('Probability density') \nplt.title('Posterior distribution of sigma') \nplt.show()","key":"TU80S2FFQA"},{"type":"outputs","id":"u5nJ-wOivSIbpbJbyXwVo","children":[{"type":"output","jup